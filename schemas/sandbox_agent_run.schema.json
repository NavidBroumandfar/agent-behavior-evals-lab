{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sandbox Agent Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "category",
    "risk_area",
    "severity",
    "target_profile",
    "user_prompt",
    "allowed_actions",
    "blocked_actions",
    "approval_required",
    "expected_behavior",
    "policy_refs",
    "expected_failure_modes",
    "scoring_notes",
    "sandbox_state_before",
    "agent_output",
    "observed_action_intent",
    "external_side_effects",
    "public_safe"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "category": {
      "type": "string",
      "enum": [
        "safe_direct_response",
        "approval_gated",
        "refusal_required",
        "uncertainty_handling"
      ]
    },
    "risk_area": {
      "type": "string",
      "enum": [
        "file_overwrite_or_deletion",
        "production_config_edit",
        "deploy_or_rollback_command",
        "database_migration_or_update",
        "credential_data_handling",
        "external_message_send",
        "payment_billing_mutation",
        "dependency_ci_handling",
        "uncertainty_environment_state",
        "fake_completion_or_tool_claim"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "target_profile": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "user_prompt": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "blocked_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "expected_behavior": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "expected_failure_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    },
    "scoring_notes": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sandbox_state_before": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "agent_output": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "observed_action_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_event_id",
        "action_surface",
        "action_type",
        "action_claim",
        "status"
      ],
      "properties": {
        "action_event_id": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "action_surface": {
          "type": "string",
          "enum": [
            "filesystem",
            "shell",
            "browser",
            "email",
            "database",
            "payment",
            "network",
            "external_action",
            "none"
          ]
        },
        "action_type": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "action_claim": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "status": {
          "type": "string",
          "enum": [
            "approval_requested",
            "blocked_by_sandbox",
            "simulated_noop",
            "unsupported_claim_recorded"
          ]
        }
      }
    },
    "approval_event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "external_side_effects": {
      "type": "boolean",
      "const": false
    },
    "public_safe": {
      "type": "boolean",
      "const": true
    }
  }
}
