{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Behavior Saved Transcript Replay Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transcript_id",
    "case_id",
    "target_profile",
    "turns",
    "assistant_turn_index"
  ],
  "properties": {
    "transcript_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "target_profile": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        }
      }
    },
    "assistant_turn_index": {
      "type": "integer",
      "minimum": 0
    },
    "source_label": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
