__pycache__/
*.pyc
*.egg-info/
.venv/
.fleet-venv/
.crew-venv/
.DS_Store

# Secrets and credentials — generic safety net (never commit these).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
secrets.*
.aws/
.ssh/
# Recursive, not single-level. These were `traces/raw/*.local.jsonl` until
# 2026-08-20, which ignores only the top level — a run that writes into
# traces/raw/<run-name>/ left every raw log, error sidecar and run manifest
# tracked-but-unignored, one `git add -A` away from publishing model output
# derived from held-out prompts and action strings carrying fixture identifier
# values. Found by an audit of the first sweep that used a subdirectory.
traces/raw/**/*.local.jsonl
traces/raw/**/*.local.json
traces/raw/**/*.log
traces/scored/**/*.local.jsonl
traces/external/**/*.local.jsonl
traces/external/*.private.jsonl
traces/external/*.reviewed.jsonl
reports/comparisons/*.local.md
*.manifest_entry.local.json
private_evidence/
reports/private/

# Pro/private workflow artifacts must not be added to the public repo.
sales-demos/
customer-audit-templates/
customer-evidence/
private-evidence/
raw-evidence/
customer-reports/
buyer-notes/
call-notes/
crm/
signed-commitments/
case-study-approvals/
pilot-feedback/
pricing/
discovery-notes/
contracts/
leads/
docs/ops/
docs/production-readiness-roadmap.md

# Internal strategy notes live in the private pro repo, not the public repo.
# Globs, not exact filenames, so future dated versions can never slip through.
ASSESSMENT-*.md
NEXT-STEPS*.md
ROADMAP-GTM-*.md
GTM-DRAFTS*.md
DIRECTION-MAP-*.md
ENGINEERING-ROADMAP*.md
PITCH-*.md
*-STRATEGY*.md
*-BRIEF*.md
company-brief*.html

# Transient sandbox test artifacts (safe to delete).
/tmp*/
reports/comparisons/tmp*/
traces/external/tmp*/
# Staging files for atomic artefact writes (reporting_utils.atomic_write_text).
# Normally removed by the os.replace that installs the artefact; one can only
# survive a hard kill mid-write, and must never be committed as evidence.
.*.tmp
# Unreviewed live CLI-agent sandbox runs; promote only after human review.
traces/live_local/
build/

# Finance red-team held-out asset — deliberately NOT published.
# A public eval set is a burned eval set: scenarios on public GitHub end up in the
# next training run, and a memorised temptation measures nothing. Kept local; see
# evals/benchmarks/finance_redteam/HELD-OUT.md for what is withheld and why.
evals/benchmarks/finance_redteam/cases.jsonl
evals/benchmarks/finance_redteam/manifest.json
evals/benchmarks/finance_redteam/finance_sandbox_tools.py
evals/benchmarks/finance_redteam/BUILD-NOTES.md

